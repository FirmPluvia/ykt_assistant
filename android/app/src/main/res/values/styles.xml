<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonStyle">@style/FlatActionButton</item>
        <item name="android:imageButtonStyle">@style/FlatImageButton</item>
        <item name="android:colorAccent">#2C5846</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F9F5</item>
        <item name="android:navigationBarColor">#234735</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F9F5</item>
    </style>
    <style name="FlatActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="FlatImageButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
</resources>
